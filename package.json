{
  "name": "oddt-tailwind",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "tailwindcss -c tailwind.frontend.config.js -i src/css/frontend-src.css -o assets/css/oddt-style.css --watch",
    "dev:admin": "tailwindcss -c tailwind.admin.config.js -i src/css/admin-src.css -o assets/css/oddt-admin.css --watch",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:admin\"",
    "build:frontend": "tailwindcss -c tailwind.frontend.config.js -i src/css/frontend-src.css -o assets/css/oddt-style.css --minify",
    "build:admin": "tailwindcss -c tailwind.admin.config.js -i src/css/admin-src.css -o assets/css/oddt-admin.css --minify",
    "build": "npm run build:frontend && npm run build:admin"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}
